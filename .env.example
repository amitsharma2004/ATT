# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and fill in your tokens/keys
# ==============================================================================

# Application Settings
APP_NAME=STT-Speaker-Pipeline
APP_ENV=production
DEBUG=False

# Storage Directory
STORAGE_DIR=storage

# Audio Processing Configuration
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
MAX_AUDIO_SIZE_MB=500
ALLOWED_AUDIO_EXTENSIONS=["wav","mp3","m4a","flac","ogg","aac","wma"]

# Hugging Face & Compute Device (cpu for universal compatibility)
DEVICE=cpu
DIARIZATION_DEVICE=cpu
HF_TOKEN=your_huggingface_token_here
WHISPER_MODEL_NAME=openai/whisper-large-v3

# Sarvam AI Batch STT Settings
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_MODEL=saaras:v4
SARVAM_LANGUAGE_CODE=unknown
SARVAM_MODE=transcribe
SARVAM_WITH_DIARIZATION=true
SARVAM_POLL_INTERVAL_SECONDS=5
SARVAM_MAX_WAIT_SECONDS=600
